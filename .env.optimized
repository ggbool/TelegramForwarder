# Telegram Bot Configuration
TELEGRAM_TOKEN=your_bot_token
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=your_phone_number
SESSION_NAME=forwarder_session
OWNER_ID=your_telegram_id

# Database Configuration
DATABASE_NAME=forward_bot.db

# Timing Display Configuration
# Show timing footer in forwarded messages (source time, forward time, arrival time)
# Set to 0 to disable. Default: 1 (enabled)
SHOW_TIMING_FOOTER=1

# Show timing footer in bot reply messages (edited/deleted notifications)
# Set to 0 to disable. Default: 1 (enabled)
SHOW_REPLY_TIMING=1

# ===========================================
# 性能优化配置
# ===========================================

# Forwarding Performance Configuration
# Maximum concurrent forwards (adjust based on Telegram API limits)
# 推荐值: 50 (平衡性能和API限制)
# 警告: 设置过高可能导致Telegram API限流
MAX_PARALLEL_FORWARDS=50

# 媒体缓存配置（秒）
# 媒体文件缓存时间，避免重复下载
# 推荐值: 1800 (30分钟)
MEDIA_CACHE_TTL=1800

# 过滤器缓存配置（秒）
# 过滤规则缓存时间，减少数据库查询
# 推荐值: 300 (5分钟)
FILTER_CACHE_TTL=300

# 网络优化配置
# 连接重试次数
CONNECTION_RETRIES=5

# 重试延迟（秒）
RETRY_DELAY=1

# 连接超时时间（秒）
TIMEOUT=30

# Flood限制阈值（秒）
# 当遇到Flood限制时，等待时间低于此值才会自动等待
FLOOD_SLEEP_THRESHOLD=60

# 日志配置
# 生产环境建议使用 WARNING，开发环境使用 INFO
LOG_LEVEL=WARNING

# 代理配置（如果需要）
# SOCKS5代理示例: socks5://127.0.0.1:6888
# HTTP代理示例: http://127.0.0.1:8080
# HTTP_PROXY=socks5://127.0.0.1:6888
# HTTPS_PROXY=socks5://127.0.0.1:6888

# ===========================================
# 高级优化选项
# ===========================================

# 启用快速文本转发（推荐）
# 对于纯文本消息，跳过媒体处理流程
ENABLE_FAST_TEXT_FORWARD=1

# 启用媒体预下载（可选）
# 预下载热门媒体文件，减少转发延迟
# 警告: 会增加存储空间使用
ENABLE_PREDOWNLOAD=0

# 批量转发大小
# 每次批量处理的消息数量
BATCH_SIZE=10

# 数据库连接池大小
DB_POOL_SIZE=5

# 启用过滤器缓存（推荐）
ENABLE_FILTER_CACHE=1

# 启用媒体缓存（推荐）
ENABLE_MEDIA_CACHE=1